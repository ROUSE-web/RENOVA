---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BrandIcon from "../components/BrandIcon.astro";
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="es">
  <head>
    <MainHead title={title} description={description} />
  </head>
  <body>
    <Analytics />
    <!-- Video Intro Overlay -->
    <div id="video-intro" class="video-intro" role="dialog" aria-modal="true" aria-label="Presentación de Renovate" hidden>
      <video
        id="intro-video"
        class="intro-video"
        width="720"
        height="1280"
        playsinline
        muted
        preload="none"
        aria-label="Animación del logotipo de Renovate Estudio Creativo"
      >
        <source src="/assets/intro.mp4" type="video/mp4" />
      </video>

      <button id="play-intro" class="control-btn play-btn" type="button" hidden>
        Reproducir presentación
      </button>

      <button
        id="toggle-sound"
        class="control-btn sound-btn"
        aria-label="Activar sonido"
        aria-pressed="false"
        type="button"
      >
        <!-- Playback begins muted for mobile autoplay. -->
        <svg
          id="icon-muted"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>

        <svg
          id="icon-unmuted"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
          ></path>
        </svg>
      </button>

      <button
        id="skip-intro"
        class="control-btn skip-btn"
        aria-label="Saltar intro"
      >
        <span>Saltar</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polygon points="5 4 15 12 5 20 5 4"></polygon>
          <line x1="19" y1="5" x2="19" y2="19"></line>
        </svg>
      </button>
    </div>

    <div class="stack backgrounds">
      <Nav />
      <slot />
      <Footer />
    </div>

    <aside class="floating-cta">
      <a
        class="contact-button"
        href="https://wa.me/59175923339"
        aria-label="¿Cómo puedo ayudarte? Escríbenos por WhatsApp"
      >
        <span class="cta-text" aria-hidden="true">¿Cómo puedo ayudarte?</span>
        <span class="contact-icon"><BrandIcon icon="whatsapp-logo" /></span>
      </a>
    </aside>

    <script>
      import { transitionIntroToLogo } from "../scripts/introTransition";

      const videoIntro = document.getElementById("video-intro")!;
      const introVideo = document.getElementById("intro-video") as HTMLVideoElement;
      const skipBtn = document.getElementById("skip-intro")!;
      const soundBtn = document.getElementById("toggle-sound")!;
      const playBtn = document.getElementById("play-intro")!;
      const iconMuted = document.getElementById("icon-muted")!;
      const iconUnmuted = document.getElementById("icon-unmuted")!;
      const pageContent = document.querySelector<HTMLElement>(".backgrounds")!;
      const floatingContact = document.querySelector<HTMLElement>(".floating-cta")!;
      const SESSION_KEY = "renova_intro_watched";
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let closingIntro = false;
      let previousFocus: HTMLElement | null = null;
      let previousOverflow = "";
      let previousRootOverflow = "";

      async function hideIntro(animateLogo = false) {
        if (closingIntro || videoIntro.hidden) return;
        closingIntro = true;
        introVideo.pause();
        try {
          let transferred = false;
          if (animateLogo && !reduceMotion.matches) {
            try {
              transferred = await transitionIntroToLogo(introVideo, videoIntro);
            } catch {
              // Keep the page accessible if frame capture or animation is unavailable.
            }
          }
          if (!transferred && !reduceMotion.matches && !videoIntro.hidden) {
            videoIntro.classList.add("fade-out");
            await new Promise((resolve) => window.setTimeout(resolve, 450));
          }
        } finally {
          videoIntro.hidden = true;
          pageContent.inert = false;
          floatingContact.inert = false;
          document.body.style.overflow = previousOverflow;
          document.documentElement.style.overflow = previousRootOverflow;
          try { sessionStorage.setItem(SESSION_KEY, "true"); } catch {}
          previousFocus?.focus({ preventScroll: true });
        }
      }

      function updateSoundIcons() {
        iconMuted.classList.toggle("hidden", !introVideo.muted);
        iconUnmuted.classList.toggle("hidden", introVideo.muted);
        soundBtn.setAttribute("aria-label", introVideo.muted ? "Activar sonido" : "Silenciar presentación");
        soundBtn.setAttribute("aria-pressed", String(!introVideo.muted));
      }

      async function playIntro() {
        playBtn.hidden = true;
        try {
          await introVideo.play();
        } catch {
          if (!closingIntro && !videoIntro.hidden) {
            playBtn.hidden = false;
            playBtn.focus({ preventScroll: true });
          }
        }
      }

      let watched = false;
      try { watched = Boolean(sessionStorage.getItem(SESSION_KEY)); } catch {}

      if (!watched) {
        previousFocus = document.activeElement as HTMLElement;
        previousOverflow = document.body.style.overflow;
        previousRootOverflow = document.documentElement.style.overflow;
        videoIntro.hidden = false;
        pageContent.inert = true;
        floatingContact.inert = true;
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
        introVideo.muted = true;
        updateSoundIcons();
        skipBtn.focus({ preventScroll: true });
        void playIntro();
      }

      introVideo.addEventListener("ended", () => void hideIntro(true));
      introVideo.addEventListener("error", () => void hideIntro());
      introVideo.querySelector("source")?.addEventListener("error", () => void hideIntro());
      introVideo.addEventListener("volumechange", updateSoundIcons);
      playBtn.addEventListener("click", () => void playIntro());
      skipBtn.addEventListener("click", () => void hideIntro());
      soundBtn.addEventListener("click", () => {
        introVideo.muted = !introVideo.muted;
      });

      videoIntro.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideIntro();
        if (event.key === "Tab") {
          const controls = Array.from(videoIntro.querySelectorAll<HTMLButtonElement>("button:not([hidden])"));
          const first = controls[0];
          const last = controls[controls.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });

      // Add "loaded" class once the document has completely loaded.
      addEventListener("load", () =>
        document.documentElement.classList.add("loaded"),
      );
    </script>

    <style>
      /* The vertical film keeps its full 9:16 frame on every screen. */
      .video-intro {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        z-index: 10001;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        isolation: isolate;
        background: linear-gradient(180deg, #e5e5e5, #d9dadd);
        transition: opacity .45s ease-out, visibility .45s ease-out;
      }

      .hidden,
      .video-intro[hidden],
      .control-btn[hidden] {
        display: none;
      }

      .video-intro.fade-out {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .intro-video {
        display: block;
        width: min(100%, 720px, 56.25vh);
        width: min(100%, 720px, 56.25dvh);
        height: auto;
        max-height: 100%;
        min-height: 0;
        aspect-ratio: 9 / 16;
        object-fit: contain;
        object-position: center;
        /* Blend only the film's empty margins into the surrounding gray. */
        mask-image:
          linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent),
          linear-gradient(180deg, transparent, #000 6%, #000 94%, transparent);
        mask-composite: intersect;
      }

      .control-btn {
        position: absolute;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        min-height: 2.75rem;
        padding: .75rem 1.25rem;
        border: 1px solid rgb(84 37 112 / 20%);
        border-radius: 999px;
        background: rgb(255 255 255 / 80%);
        color: #542570;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 16px rgb(46 21 62 / 8%);
        font-family: var(--font-body);
        font-size: .875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color .2s ease, transform .2s ease;
      }

      .control-btn:hover {
        background: #fff;
        transform: translateY(-2px);
      }

      .control-btn:focus-visible {
        outline: 2px solid #7611a6;
        outline-offset: 4px;
      }

      .skip-btn {
        bottom: max(2rem, env(safe-area-inset-bottom));
        right: max(2rem, env(safe-area-inset-right));
      }

      .sound-btn {
        bottom: max(2rem, env(safe-area-inset-bottom));
        left: max(2rem, env(safe-area-inset-left));
        width: 2.75rem;
        padding: .625rem;
      }

      .play-btn {
        bottom: max(6rem, calc(env(safe-area-inset-bottom) + 4rem));
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
      }

      .play-btn:hover { transform: translateX(-50%); }

      @media (max-width: 48em), (max-height: 32em) {
        .skip-btn {
          right: max(1rem, env(safe-area-inset-right));
          bottom: max(1rem, env(safe-area-inset-bottom));
        }

        .sound-btn {
          left: max(1rem, env(safe-area-inset-left));
          bottom: max(1rem, env(safe-area-inset-bottom));
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .video-intro, .control-btn { transition: none; }
      }

      :root {
        --_placeholder-bg: linear-gradient(transparent, transparent);
        --bg-image-main: url("/assets/backgrounds/bg-main-light-800w.jpg");
        --bg-image-main-curves: url("/assets/backgrounds/bg-main-light.svg");
        --bg-image-subtle-1: var(--_placeholder-bg);
        --bg-image-subtle-2: var(--_placeholder-bg);
        --bg-image-footer: var(--_placeholder-bg);
        --bg-svg-blend-mode: overlay;
        --bg-blend-mode: darken;
        --bg-image-aspect-ratio: 2.25;
        --bg-scale: 1.68;
        --bg-aspect-ratio: calc(var(--bg-image-aspect-ratio) / var(--bg-scale));
        --bg-gradient-size: calc(var(--bg-scale) * 100%);
      }

      :root.theme-dark {
        --bg-image-main: url("/assets/backgrounds/bg-main-dark-800w.jpg");
        --bg-image-main-curves: url("/assets/backgrounds/bg-main-dark.svg");
        --bg-svg-blend-mode: darken;
        --bg-blend-mode: lighten;
      }

      /* These backgrounds are displayed below the fold, so we lazy load them
			   once the `.loaded` class has been set.  */
      :root.loaded {
        --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-light-800w.jpg");
        --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-light-800w.jpg");
        --bg-image-footer: url("/assets/backgrounds/bg-footer-light-800w.jpg");
      }
      :root.loaded.theme-dark {
        --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-dark-800w.jpg");
        --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-dark-800w.jpg");
        --bg-image-footer: url("/assets/backgrounds/bg-footer-dark-800w.jpg");
      }

      @media (min-width: 50em) {
        :root {
          --bg-scale: 1;
          --bg-image-main: url("/assets/backgrounds/bg-main-light-1440w.jpg");
        }
        :root.theme-dark {
          --bg-image-main: url("/assets/backgrounds/bg-main-dark-1440w.jpg");
        }

        :root.loaded {
          --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-light-1440w.jpg");
          --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-light-1440w.jpg");
          --bg-image-footer: url("/assets/backgrounds/bg-footer-light-1440w.jpg");
        }
        :root.loaded.theme-dark {
          --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-dark-1440w.jpg");
          --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-dark-1440w.jpg");
          --bg-image-footer: url("/assets/backgrounds/bg-footer-dark-1440w.jpg");
        }
      }
      .stack {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .backgrounds {
        min-height: 100vh;
        isolation: isolate;
        padding-top: 7rem;
        background:
					/*noise*/
          url("/assets/backgrounds/noise.png") top center/220px repeat,
          /*footer*/ var(--bg-image-footer) bottom
            center/var(--bg-gradient-size) no-repeat,
          /*header1*/ var(--bg-image-main-curves) top
            center/var(--bg-gradient-size) no-repeat,
          /*header2*/ var(--bg-image-main) top center/var(--bg-gradient-size)
            no-repeat,
          /*base*/ var(--gray-999);
        background-blend-mode: /*noise*/
          overlay,
          /*footer*/ var(--bg-blend-mode),
          /*header1*/ var(--bg-svg-blend-mode),
          /*header2*/ normal,
          /*base*/ normal;
      }
      @media (forced-colors: active) {
        .backgrounds {
          background: none;
          background-blend-mode: none;
          --bg-gradient-size: none;
        }
      }

      /* Floating WhatsApp contact */
      .floating-cta {
        position: fixed;
        bottom: max(1.5rem, env(safe-area-inset-bottom));
        right: max(1.5rem, env(safe-area-inset-right));
        z-index: 1000;
      }

      .contact-button {
        --contact-size: 3.75rem;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: var(--contact-size);
        max-width: calc(100vw - 3rem);
        height: var(--contact-size);
        padding: .55rem;
        overflow: hidden;
        border: 1px solid rgb(118 17 166 / 20%);
        border-radius: 999px;
        background: rgb(255 255 255 / 94%);
        color: #382345;
        box-shadow: 0 8px 28px rgb(37 12 56 / 14%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        text-decoration: none;
        transition:
          width .45s cubic-bezier(.22, 1, .36, 1),
          transform .3s ease,
          border-color .3s ease,
          box-shadow .3s ease;
      }

      :global(.theme-dark) .contact-button {
        background: rgb(27 18 40 / 94%);
        border-color: rgb(197 139 234 / 30%);
        color: #f5edf9;
        box-shadow: 0 8px 28px rgb(0 0 0 / 28%);
      }

      .contact-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background: #8b3fbd;
        color: #fff;
      }

      .cta-text {
        position: absolute;
        left: 1.1rem;
        right: var(--contact-size);
        overflow: hidden;
        opacity: 0;
        transform: translateX(.75rem);
        pointer-events: none;
        transition: opacity .18s ease, transform .35s cubic-bezier(.22, 1, .36, 1);
        font-size: .875rem;
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
      }

      .contact-button:focus-visible {
        width: 16.5rem;
      }

      .contact-button:focus-visible .cta-text {
        opacity: 1;
        transform: translateX(0);
        transition-delay: .08s;
      }

      @media (hover: hover) {
        .contact-button:hover {
          width: 16.5rem;
          transform: translateY(-3px);
          border-color: #b675df;
          box-shadow: 0 12px 32px rgb(118 17 166 / 22%);
        }

        .contact-button:hover .cta-text {
          opacity: 1;
          transform: translateX(0);
          transition-delay: .08s;
        }
      }

      .contact-button:focus-visible {
        outline: 3px solid var(--link-color);
        outline-offset: 4px;
      }

      .contact-button:active {
        transform: translateY(0);
      }

      @media (max-width: 49.99em) {
        .floating-cta {
          bottom: max(1rem, env(safe-area-inset-bottom));
          right: max(1rem, env(safe-area-inset-right));
        }

        .contact-button {
          --contact-size: 3.5rem;
          padding: .4375rem;
        }

      }

      @media (prefers-reduced-motion: reduce) {
        .contact-button,
        .cta-text { transition: none; }
        .contact-button:hover { transform: none; }
      }
    </style>
  </body>
</html>
