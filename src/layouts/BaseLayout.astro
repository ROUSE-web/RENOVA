---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BrandIcon from "../components/BrandIcon.astro";
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="es">
  <head>
    <MainHead title={title} description={description} />
  </head>
  <body>
    <Analytics />
    <!-- Video Intro Overlay -->
    <div id="video-intro" class="video-intro">
      <video id="intro-video" playsinline class="intro-video">
        <source src="/assets/Renova.mp4" type="video/mp4" />
      </video>

      <button
        id="toggle-sound"
        class="control-btn sound-btn"
        aria-label="Alternar sonido"
      >
        <!-- Icon Muted (Hidden by default) -->
        <svg
          id="icon-muted"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
        <!-- Icon Unmuted (Visible by default) -->
        <svg
          id="icon-unmuted"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
          ></path>
        </svg>
      </button>

      <button
        id="skip-intro"
        class="control-btn skip-btn"
        aria-label="Saltar intro"
      >
        <span>Saltar</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polygon points="5 4 15 12 5 20 5 4"></polygon>
          <line x1="19" y1="5" x2="19" y2="19"></line>
        </svg>
      </button>
    </div>

    <div class="stack backgrounds">
      <Nav />
      <slot />
      <Footer />
    </div>

    <aside class="floating-cta">
      <a
        class="contact-button"
        href="https://wa.me/59175923339"
        aria-label="¿Cómo puedo ayudarte? Escríbenos por WhatsApp"
      >
        <span class="cta-text" aria-hidden="true">¿Cómo puedo ayudarte?</span>
        <span class="contact-icon"><BrandIcon icon="whatsapp-logo" /></span>
      </a>
    </aside>

    <script>
      // Video Intro Logic
      const videoIntro = document.getElementById("video-intro");
      const introVideo = document.getElementById(
        "intro-video",
      ) as HTMLVideoElement;
      const skipBtn = document.getElementById("skip-intro");
      const soundBtn = document.getElementById("toggle-sound");
      const iconMuted = document.getElementById("icon-muted");
      const iconUnmuted = document.getElementById("icon-unmuted");
      const SESSION_KEY = "renova_intro_watched";

      function hideIntro() {
        if (videoIntro) {
          videoIntro.classList.add("fade-out");
          setTimeout(() => {
            videoIntro.style.display = "none";
            document.body.style.overflow = "";
            sessionStorage.setItem(SESSION_KEY, "true");
          }, 800);
        }
      }

      function updateSoundIcons() {
        if (!iconMuted || !iconUnmuted || !introVideo) return;
        if (introVideo.muted) {
          iconMuted.classList.remove("hidden");
          iconUnmuted.classList.add("hidden");
        } else {
          iconMuted.classList.add("hidden");
          iconUnmuted.classList.remove("hidden");
        }
      }

      // Check if intro was already watched in this session
      if (sessionStorage.getItem(SESSION_KEY)) {
        if (videoIntro) {
          videoIntro.style.display = "none";
        }
      } else {
        // Prevent scrolling while video is playing
        document.body.style.overflow = "hidden";

        // When video ends, hide the intro
        if (introVideo) {
          // Attempt to play with sound
          const playPromise = introVideo.play();

          if (playPromise !== undefined) {
            playPromise.catch((error) => {
              // Auto-play was prevented (likely due to sound).
              // Fallback: Mute and play.
              console.log(
                "Autoplay with sound blocked. Falling back to muted autoplay.",
              );
              introVideo.muted = true;
              updateSoundIcons();
              introVideo.play();
            });
          }

          introVideo.addEventListener("ended", hideIntro);
        }
      }

      // Sound Toggle Logic
      if (soundBtn && introVideo) {
        soundBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          introVideo.muted = !introVideo.muted;
          updateSoundIcons();
        });
      }

      // Skip button functionality
      if (skipBtn) {
        skipBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          hideIntro();
        });
      }

      // Also allow clicking anywhere on the video to skip
      if (videoIntro) {
        videoIntro.addEventListener("click", (e) => {
          if (e.target === videoIntro || e.target === introVideo) {
            hideIntro();
          }
        });
      }

      // Add "loaded" class once the document has completely loaded.
      addEventListener("load", () =>
        document.documentElement.classList.add("loaded"),
      );
    </script>

    <style>
      /* Video Intro Styles */
      .video-intro {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        background-color: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition:
          opacity 0.8s ease-out,
          visibility 0.8s ease-out;
      }

      .hidden {
        display: none;
      }

      .video-intro.fade-out {
        opacity: 0;
        visibility: hidden;
      }

      .intro-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .control-btn {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 50px;
        color: white;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 10000;
      }

      .control-btn:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: scale(1.05);
      }

      .control-btn:active {
        transform: scale(0.98);
      }

      .skip-btn {
        bottom: 40px;
        right: 40px;
      }

      .sound-btn {
        bottom: 40px;
        left: 40px;
        padding: 12px;
        border-radius: 50%;
      }

      @media (max-width: 768px) {
        .skip-btn {
          bottom: 30px;
          right: 20px;
          padding: 10px 20px;
          font-size: 13px;
        }

        .sound-btn {
          bottom: 30px;
          left: 20px;
          padding: 10px;
        }
      }

      /* Mejor visualización del video en móviles verticales */
      @media (max-width: 768px) and (orientation: portrait) {
        .intro-video {
          width: 100%;
          height: auto;
          max-height: 100vh;
          object-fit: contain;
        }

        .video-intro {
          display: flex;
          align-items: center;
          justify-content: center;
        }
      }

      :root {
        --_placeholder-bg: linear-gradient(transparent, transparent);
        --bg-image-main: url("/assets/backgrounds/bg-main-light-800w.jpg");
        --bg-image-main-curves: url("/assets/backgrounds/bg-main-light.svg");
        --bg-image-subtle-1: var(--_placeholder-bg);
        --bg-image-subtle-2: var(--_placeholder-bg);
        --bg-image-footer: var(--_placeholder-bg);
        --bg-svg-blend-mode: overlay;
        --bg-blend-mode: darken;
        --bg-image-aspect-ratio: 2.25;
        --bg-scale: 1.68;
        --bg-aspect-ratio: calc(var(--bg-image-aspect-ratio) / var(--bg-scale));
        --bg-gradient-size: calc(var(--bg-scale) * 100%);
      }

      :root.theme-dark {
        --bg-image-main: url("/assets/backgrounds/bg-main-dark-800w.jpg");
        --bg-image-main-curves: url("/assets/backgrounds/bg-main-dark.svg");
        --bg-svg-blend-mode: darken;
        --bg-blend-mode: lighten;
      }

      /* These backgrounds are displayed below the fold, so we lazy load them
			   once the `.loaded` class has been set.  */
      :root.loaded {
        --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-light-800w.jpg");
        --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-light-800w.jpg");
        --bg-image-footer: url("/assets/backgrounds/bg-footer-light-800w.jpg");
      }
      :root.loaded.theme-dark {
        --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-dark-800w.jpg");
        --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-dark-800w.jpg");
        --bg-image-footer: url("/assets/backgrounds/bg-footer-dark-800w.jpg");
      }

      @media (min-width: 50em) {
        :root {
          --bg-scale: 1;
          --bg-image-main: url("/assets/backgrounds/bg-main-light-1440w.jpg");
        }
        :root.theme-dark {
          --bg-image-main: url("/assets/backgrounds/bg-main-dark-1440w.jpg");
        }

        :root.loaded {
          --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-light-1440w.jpg");
          --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-light-1440w.jpg");
          --bg-image-footer: url("/assets/backgrounds/bg-footer-light-1440w.jpg");
        }
        :root.loaded.theme-dark {
          --bg-image-subtle-1: url("/assets/backgrounds/bg-subtle-1-dark-1440w.jpg");
          --bg-image-subtle-2: url("/assets/backgrounds/bg-subtle-2-dark-1440w.jpg");
          --bg-image-footer: url("/assets/backgrounds/bg-footer-dark-1440w.jpg");
        }
      }
      .stack {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .backgrounds {
        min-height: 100vh;
        isolation: isolate;
        padding-top: 7rem;
        background:
					/*noise*/
          url("/assets/backgrounds/noise.png") top center/220px repeat,
          /*footer*/ var(--bg-image-footer) bottom
            center/var(--bg-gradient-size) no-repeat,
          /*header1*/ var(--bg-image-main-curves) top
            center/var(--bg-gradient-size) no-repeat,
          /*header2*/ var(--bg-image-main) top center/var(--bg-gradient-size)
            no-repeat,
          /*base*/ var(--gray-999);
        background-blend-mode: /*noise*/
          overlay,
          /*footer*/ var(--bg-blend-mode),
          /*header1*/ var(--bg-svg-blend-mode),
          /*header2*/ normal,
          /*base*/ normal;
      }
      @media (forced-colors: active) {
        .backgrounds {
          background: none;
          background-blend-mode: none;
          --bg-gradient-size: none;
        }
      }

      /* Floating WhatsApp contact */
      .floating-cta {
        position: fixed;
        bottom: max(1.5rem, env(safe-area-inset-bottom));
        right: max(1.5rem, env(safe-area-inset-right));
        z-index: 1000;
      }

      .contact-button {
        --contact-size: 3.75rem;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: var(--contact-size);
        max-width: calc(100vw - 3rem);
        height: var(--contact-size);
        padding: .55rem;
        overflow: hidden;
        border: 1px solid rgb(118 17 166 / 20%);
        border-radius: 999px;
        background: rgb(255 255 255 / 94%);
        color: #382345;
        box-shadow: 0 8px 28px rgb(37 12 56 / 14%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        text-decoration: none;
        transition:
          width .45s cubic-bezier(.22, 1, .36, 1),
          transform .3s ease,
          border-color .3s ease,
          box-shadow .3s ease;
      }

      :global(.theme-dark) .contact-button {
        background: rgb(27 18 40 / 94%);
        border-color: rgb(197 139 234 / 30%);
        color: #f5edf9;
        box-shadow: 0 8px 28px rgb(0 0 0 / 28%);
      }

      .contact-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background: #8b3fbd;
        color: #fff;
      }

      .cta-text {
        position: absolute;
        left: 1.1rem;
        right: var(--contact-size);
        overflow: hidden;
        opacity: 0;
        transform: translateX(.75rem);
        pointer-events: none;
        transition: opacity .18s ease, transform .35s cubic-bezier(.22, 1, .36, 1);
        font-size: .875rem;
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
      }

      .contact-button:focus-visible {
        width: 16.5rem;
      }

      .contact-button:focus-visible .cta-text {
        opacity: 1;
        transform: translateX(0);
        transition-delay: .08s;
      }

      @media (hover: hover) {
        .contact-button:hover {
          width: 16.5rem;
          transform: translateY(-3px);
          border-color: #b675df;
          box-shadow: 0 12px 32px rgb(118 17 166 / 22%);
        }

        .contact-button:hover .cta-text {
          opacity: 1;
          transform: translateX(0);
          transition-delay: .08s;
        }
      }

      .contact-button:focus-visible {
        outline: 3px solid var(--link-color);
        outline-offset: 4px;
      }

      .contact-button:active {
        transform: translateY(0);
      }

      @media (max-width: 49.99em) {
        .floating-cta {
          bottom: max(1rem, env(safe-area-inset-bottom));
          right: max(1rem, env(safe-area-inset-right));
        }

        .contact-button {
          --contact-size: 3.5rem;
          padding: .4375rem;
        }

      }

      @media (prefers-reduced-motion: reduce) {
        .contact-button,
        .cta-text { transition: none; }
        .contact-button:hover { transform: none; }
      }
    </style>
  </body>
</html>
