---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import CardServices from "../components/CardServices.astro";

// Page section components
import Skills from "../components/Skills.astro";
import Testimonials from "../components/Testimonials.astro";
import Skills2 from "../components/Skills2.astro";
import ParticlesBackground from "../components/ParticlesBackground.astro";
import Orbit from "../components/Orbit.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("servicios"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

// Services data
const services = [
  {
    title: "Creación de Marca",
    image: "/assets/services/branding/branding-banner.webp",
  },
  {
    title: "Diseño de Papelería Corporativa",
    image: "/assets/services/stationery/stationery-banner.webp",
  },
  {
    title: "Diseño de Empaques",
    image: "/assets/services/packaging/packaging-banner.webp",
  },
  {
    title: "Social Media",
    image: "/assets/services/social-media/social-media-banner.webp",
  },
  {
    title: "Desarrollo Web",
    image: "/assets/services/web-dev/web-dev-banner.webp",
  },
  {
    title: "Gigantografía",
    image: "/assets/services/gigantografia/gigantografia-banner.webp",
  },
  {
    title: "Fotografía en exteriores",
    image:
      "/assets/services/outdoor-photography/outdoor-photography-banner.webp",
  },
  {
    title: "Fotografía en interiores",
    image: "/assets/services/indoor-photography/indoor-photography-banner.webp",
  },
];

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <ParticlesBackground />
  <div class="stack gap-20 lg:gap-24">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero">
        <Hero
          title="RENOVATE"
          subtitle="ESTUDIO CREATIVO"
          tagline="Renovamos la forma en que las marcas se ven y se comunican."
          align="start"
        >
          <CallToAction href="/servicios/" size="sm">
            Ver Servicios <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </Hero>

        <figure class="hero-portrait">
          <div class="portrait-halo" aria-hidden="true"></div>
          <div class="portrait-ring" aria-hidden="true"></div>
          <img
            src="/assets/hero-rouse.webp"
            alt="Rouse Balderrama, CEO de Renovate Estudio Creativo"
            width="1254"
            height="1254"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <figcaption>
            <span class="caption-mark" aria-hidden="true">↗</span>
            <span>
              <strong>Rouse Balderrama</strong>
              <small>CEO · Renovate Estudio Creativo</small>
            </span>
          </figcaption>
        </figure>
      </header>

      <Skills2 />
      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-24">
      <section class="section with-background">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Conoce Nuestros Servicios</h3>
          <p>Estos son nuestros servicios más destacados.</p>
        </header>

        <div class="gallery services-grid">
          {
            services.map((service) => (
              <CardServices title={service.title} image={service.image} />
            ))
          }
        </div>
      </section>

      <section class="section with-background bg-variant">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Experiencias de nuestros clientes</h3>
          <p>
            Algunos de nuestros clientes han compartido sus experiencias con
            nosotros.
          </p>
        </header>

        <div class="gallery">
          <Testimonials />
        </div>
      </section>
    </main>
    {/* Seccion orbit de nuestro equipo oculto temporalmente */}
    <div class="wrapper stack gap-8 lg:gap-8" style="display: none;">
      <Orbit />
    </div>
  </div>
</BaseLayout>

<style>
  .hero-portrait {
    position: relative;
    isolation: isolate;
    width: min(100%, 460px);
    min-width: 0;
    margin: 0 0 2rem;
    color: var(--gray-100);
    --home-accent: #7b3db3;
    --home-muted: #645e70;
    --home-line: #e5dfea;
    aspect-ratio: 1;
  }

  .portrait-halo {
    position: absolute;
    inset: 10% -4% 0 3%;
    z-index: -2;
    border-radius: 50% 50% 44% 44%;
    background: radial-gradient(
      ellipse at 55% 45%,
      #e3cff8,
      #f2e9fa 65%,
      transparent 72%
    );
  }

  :global(.theme-dark) .portrait-halo {
    background: radial-gradient(
      ellipse at 55% 45%,
      #5c3478,
      #30203f 65%,
      transparent 73%
    );
  }

  .portrait-ring {
    position: absolute;
    inset: 11% 0 6% 6%;
    z-index: -1;
    border: 1px solid var(--home-line);
    border-radius: 50%;
    transform: rotate(-20deg) scaleX(1.1);
  }

  .hero-portrait img {
    display: block;
    position: relative;
    width: 110%;
    max-width: none;
    margin-left: -5%;
    mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
  }

  .hero-portrait figcaption {
    position: absolute;
    bottom: 4%;
    left: 5%;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--home-line);
    border-radius: 1rem;
    background: var(--gray-999_40);
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 36px #2613390a;
  }

  .hero-portrait figcaption strong,
  .hero-portrait figcaption small {
    display: block;
  }

  .hero-portrait figcaption strong {
    font: 500 1.2rem var(--font-brand);
  }

  .hero-portrait figcaption small {
    font-size: 0.65rem;
    color: var(--home-muted);
    margin-top: 0.1rem;
  }

  .caption-mark {
    color: var(--home-accent);
    font-size: 1.8rem;
  }

  :global(.theme-dark) .hero-portrait {
    --home-accent: #c99cf0;
    --home-muted: #b7adc5;
    --home-line: #352b45;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .hero :global(a:hover svg) {
    transform: translateX(0.45rem);
  }

  .hero :global(svg) {
    transition: transform var(--theme-transition);
  }

  /* Restore original hero title size for homepage */
  .hero :global(.title) {
    font-size: var(--text-2xl);
  }
  .hero :global(.subtitle) {
    font-size: var(--text-2xl);
  }

  @media (min-width: 50em) {
    .hero :global(.title) {
      font-size: var(--text-5xl);
    }
    .hero :global(.subtitle) {
      font-size: var(--text-4xl);
    }
  }

  @media (min-width: 50em) {
    .hero {
      display: grid;
      grid-template-columns: 6fr 4fr;
      padding-inline: 2.5rem;
      gap: 3.75rem;
    }
  }

  /* ====================================================== */

  .section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    overflow-x: hidden;
  }

  .with-background {
    position: relative;
  }

  .with-background::before {
    --hero-bg: var(--bg-image-subtle-2);

    content: "";
    position: absolute;
    pointer-events: none;
    left: 50%;
    width: 100vw;
    aspect-ratio: calc(2.25 / var(--bg-scale));
    top: 0;
    transform: translateY(-75%) translateX(-50%);
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
      var(--gray-999);
    background-blend-mode: overlay, normal, normal, normal;
    mix-blend-mode: var(--bg-blend-mode);
    z-index: -1;
  }

  .with-background.bg-variant::before {
    --hero-bg: var(--bg-image-subtle-1);
  }

  .section-header {
    justify-self: center;
    text-align: center;
    width: 100%;
    max-width: min(50ch, 100%);
    font-size: var(--text-md);
    color: var(--gray-300);
    position: relative;
    z-index: 1;
  }

  .section-header h3 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 5rem;
    }

    .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    .section-header h3 {
      font-size: var(--text-4xl);
    }

    .gallery {
      grid-area: gallery;
    }
  }

  /* ====================================================== */

  .mention-card {
    display: flex;
    height: 7rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    color: var(--gray-300);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 50em) {
    .mention-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }

  /* Services Grid Styles */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
</style>
